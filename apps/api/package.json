{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "nest build && node --env-file-if-exists=.env dist/scripts/migrate.js",
    "owner:set-password": "nest build && node --env-file-if-exists=.env dist/scripts/set-password.js"
  },
  "dependencies": {
    "@fastify/secure-session": "^8.4.2",
    "@fastify/static": "^10.1.12",
    "@finance/shared": "workspace:*",
    "@nestjs/common": "^11.2.11",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.11",
    "@nestjs/platform-fastify": "^11.2.11",
    "@nestjs/swagger": "^11.4.8",
    "@nestjs/throttler": "^6.8.0",
    "better-sqlite3": "^13.2.0",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "nestjs-pino": "^4.6.1",
    "nestjs-zod": "^5.6.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuidv7": "^1.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.11",
    "@swc/core": "^1.16.22",
    "@types/better-sqlite3": "^9.6.0",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "unplugin-swc": "^2.0.0"
  }
}
