# API port (web proxies /api/** here)
PORT=3001
# local dev on Windows: 3101 if 3001 is taken (see quickstart)
# >= 32 bytes, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
API_SESSION_SECRET=
# exactly 32 bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
API_ENCRYPTION_KEY=
DATABASE_PATH=./data/app.db
# false only for plain HTTP (local container test, LAN without TLS)
COOKIE_SECURE=true
