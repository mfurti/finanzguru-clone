# API port (web proxies /api/** here)
PORT=3001
# Optional, wins over PORT (e.g. when a dev runner sets PORT for the web app).
# Local dev: API_PORT=3101
API_PORT=
# >= 32 bytes, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
API_SESSION_SECRET=
# exactly 32 bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
API_ENCRYPTION_KEY=
DATABASE_PATH=./data/app.db
# false only for plain HTTP (local container test, LAN without TLS)
COOKIE_SECURE=true
# Login attempts per minute and client IP (default 5)
LOGIN_RATE_LIMIT=5
# Scalable Capital MCP (US3). The redirect URI must point at the web app's /api proxy.
SCALABLE_MCP_URL=https://mcp.scalable.capital/mcp
SCALABLE_REDIRECT_URI=http://localhost:3000/api/sources/scalable/callback
# Daily Scalable sync at 06:00 (default false)
SCALABLE_DAILY_SYNC=false
# Bank connection through Enable Banking (005). Your own restricted-production application:
# its id and the path to its private key file. Keep the key outside the repository.
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_KEY_FILE=
ENABLE_BANKING_REDIRECT_URL=http://localhost:3000/api/sources/bank/callback
# Daily bank sync at 06:00 (default false)
BANK_DAILY_SYNC=false
# Dev only: read migrations from src/ (new files reach dist/ late in watch mode)
# MIGRATIONS_FOLDER=./src/database/migrations
